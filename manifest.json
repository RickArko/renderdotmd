{
  "manifest_version": 3,
  "name": "render.md — clean Markdown viewer",
  "short_name": "render.md",
  "version": "0.1.0",
  "description": "Render local and remote Markdown (.md) files as clean, readable pages. No trackers, no network calls, works offline.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "render.md",
    "default_popup": "src/popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["src/markdown.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
